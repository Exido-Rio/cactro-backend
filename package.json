{
  "name": "event-booking-system",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "tsoa": "tsoa spec-and-routes",
    "dev": "npm run tsoa && concurrently \"npm run tsoa -- --watch\" \"ts-node-dev --respawn --transpile-only src/index.ts\"",
    "build": "npm run tsoa && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "setup": "prisma generate && prisma migrate dev --name init"
  },
  "keywords": [
    "event-booking",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "description": "Event Booking System - Backend API with role-based access control and background tasks",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "prisma": "^6.19.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
